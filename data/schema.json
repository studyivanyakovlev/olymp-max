{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OlympiadsDataset",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "title",
      "organizer",
      "rsosh_level",
      "subjects",
      "grade_from",
      "grade_to",
      "benefits_note",
      "url",
      "source_url",
      "verified_at",
      "stages"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9_-]+$",
        "description": "Уникальный строковый идентификатор олимпиады"
      },
      "title": {
        "type": "string",
        "minLength": 3,
        "description": "Полное название олимпиады"
      },
      "organizer": {
        "type": "string",
        "minLength": 2,
        "description": "Организатор (вуз или образовательный центр)"
      },
      "rsosh_level": {
        "type": ["integer", "null"],
        "enum": [1, 2, 3, null],
        "description": "Уровень РСОШ (1, 2, 3) или null если вне перечня/ВсОШ"
      },
      "subjects": {
        "type": "array",
        "items": { "type": "string" },
        "minItems": 1,
        "description": "Предметы олимпиады (math, informatics, physics, chemistry, biology, linguistics, etc.)"
      },
      "grade_from": {
        "type": "integer",
        "minimum": 1,
        "maximum": 11,
        "description": "Минимальный класс участия"
      },
      "grade_to": {
        "type": "integer",
        "minimum": 1,
        "maximum": 11,
        "description": "Максимальный класс участия"
      },
      "benefits_note": {
        "type": "string",
        "description": "Описание льгот при поступлении (БВИ, 100 баллов ЕГЭ)"
      },
      "url": {
        "type": "string",
        "format": "uri",
        "description": "Основная ссылка на сайт олимпиады/страницу регистрации"
      },
      "source_url": {
        "type": "string",
        "format": "uri",
        "description": "Ссылка на официальный источник (приказ/регламент)"
      },
      "verified_at": {
        "type": "string",
        "format": "date-time",
        "description": "Дата и время последней верификации данных в ISO 8601 с часовым поясом"
      },
      "is_demo": {
        "type": "boolean",
        "description": "Флаг демо-олимпиады для тестирования и жюри"
      },
      "stages": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["id", "kind", "name", "starts_at", "ends_at", "format"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9_-]+$"
            },
            "kind": {
              "type": "string",
              "enum": ["registration", "qualifying", "final", "results"]
            },
            "name": {
              "type": "string",
              "minLength": 2
            },
            "starts_at": {
              "type": "string",
              "format": "date-time"
            },
            "ends_at": {
              "type": "string",
              "format": "date-time"
            },
            "region_code": {
              "type": ["string", "null"],
              "description": "Код региона РФ или null для всероссийского формата"
            },
            "format": {
              "type": "string",
              "enum": ["online", "offline", "hybrid"]
            }
          }
        }
      }
    }
  }
}
