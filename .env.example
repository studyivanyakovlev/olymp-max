# Скопируйте в .env и заполните. .env в git не коммитится.

# Токен бота MAX (выдают организаторы)
BOT_TOKEN=

# polling — локальная разработка, webhook — сервер
BOT_MODE=polling

# Публичный HTTPS-адрес сервера для вебхука и mini app, например https://example.ru
PUBLIC_URL=
WEBHOOK_SECRET=

# PostgreSQL
POSTGRES_USER=olymp
POSTGRES_PASSWORD=
POSTGRES_DB=olymp
DATABASE_URL=postgres://olymp:CHANGE_ME@db:5432/olymp

# Адрес mini app
MINIAPP_URL=

# 1 — включить демо-олимпиаду для проверки жюри
DEMO_MODE=1
