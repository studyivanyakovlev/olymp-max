# Скопируйте файл в .env и подставьте свои значения. Настоящие токены в git не коммитятся.

# Токен бота MAX (выдаётся на платформе для бизнеса MAX).
# Значение с префиксом test_ включает локальный режим: бот не подключается к MAX,
# сообщения пишутся в лог, а API принимает заголовок X-User-Id вместо подписи initData.
BOT_TOKEN=test_max_bot_token_1234567890

# Ник бота MAX без @. Сервер сам берёт его из GET /me; переменная нужна, если /me недоступен,
# и для ссылок «Поделиться» в Mini App (передаётся при сборке как VITE_BOT_NAME).
BOT_USERNAME=

# polling — для локальной разработки, webhook — для сервера с публичным HTTPS
BOT_MODE=polling

# Публичный HTTPS-адрес сервера. В режиме webhook бот регистрирует в MAX адрес ${PUBLIC_URL}/webhook
PUBLIC_URL=https://my-olymp-bot.example.com

# Секрет вебхука (необязательно): если не задан, выводится из BOT_TOKEN
WEBHOOK_SECRET=

# Адрес Mini App. Этот же адрес указывается в настройках бота на платформе MAX
MINIAPP_URL=https://my-olymp-bot.example.com/app

# Порт HTTP-сервера (REST API, Mini App, Swagger, вебхук)
PORT=3000

# PostgreSQL. Если оставить пустым, используется встроенный PGlite (каталог ~/.olymp_max_pglite
# или PGLITE_DIR). В docker compose адрес базы задаётся автоматически.
DATABASE_URL=
PGLITE_DIR=

# Демо-олимпиада для жюри: напоминание приходит через 1 минуту после подписки
DEMO_MODE=true

NODE_ENV=development

# Только для docker compose
POSTGRES_USER=olymp_user
POSTGRES_PASSWORD=olymp_pass
POSTGRES_DB=olymp_db
# Домен для Caddy (профиль https): docker compose --profile https up -d --build
PUBLIC_DOMAIN=
