# Токен бота MAX (выдаётся в BotFather / платформе MAX)
BOT_TOKEN=test_max_bot_token_1234567890

# Токен Telegram бота (создаётся в Telegram через @BotFather)
TELEGRAM_BOT_TOKEN=

# Режим работы бота: 'polling' для локальной разработки, 'webhook' для сервера с HTTPS
BOT_MODE=polling

# Публичный HTTPS-адрес сервера (нужен при BOT_MODE=webhook)
PUBLIC_URL=https://my-olymp-bot.example.com

# Порт бэкенд-сервера
PORT=3000

# Подключение к PostgreSQL. Если оставить пустым, используется встроенный PGlite (локальный PostgreSQL без установки сервера!)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/olymp_max

# URL клиентского mini app
MINIAPP_URL=https://my-olymp-bot.example.com/app

# Демо-режим для жюри (включает демо-олимпиаду с напоминанием через 1 минуту)
DEMO_MODE=true

NODE_ENV=development
